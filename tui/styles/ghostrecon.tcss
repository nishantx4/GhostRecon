/* ═══════════════════════════════════════════════════════════════════════
   GhostRecon — "Ghost Ops" theme
   One signature cold accent, flat/sharp panels, muted semantic severity
   scale. Keep hex values in sync with tui/theme.py (used for Rich markup
   in widget code that CSS can't reach).
   ═══════════════════════════════════════════════════════════════════════ */

$bg:            #0a0b0d;
$bg-panel:      #101317;
$bg-elevated:   #171b20;

$border:        #262b33;
$border-strong: #3a4048;

$text:          #c9d1d9;
$text-dim:      #5b6472;
$text-faint:    #383e47;

$accent:        #45d1c4;
$accent-dim:    #245853;

$ok:            #4ba876;
$crit:          #e5484d;
$high:          #d97a4d;
$med:           #c9a227;
$low:           #4a90c4;
$info:          #5b6472;

Screen {
    background: $bg;
}

Header {
    background: $bg-panel;
    color: $accent;
    text-style: bold;
    border-bottom: solid $border;
}

Footer {
    background: $bg-panel;
    color: $text-dim;
}

Footer > .footer--key {
    color: $accent;
    text-style: bold;
}

Footer > .footer--description {
    color: $text-dim;
}

.title {
    content-align: center middle;
    text-style: bold;
    color: $accent;
    padding: 1 0;
}

/* ── Dashboard: 3-column, 3-row grid ── */
DashboardScreen {
    layout: grid;
    grid-size: 3 3;
    grid-rows: 3 1fr 1fr;
    grid-columns: 1fr 2fr 1fr;
    grid-gutter: 1 1;
    padding: 1 1;
    background: $bg;
}

/* Row 1: Info bar spans full width */
#info_bar {
    column-span: 3;
    height: 3;
    background: $bg-panel;
    border: solid $border;
    padding: 0 1;
}

#info_bar_row {
    height: 1;
    width: 100%;
}

.info-cell {
    width: 1fr;
    height: 1;
    content-align: center middle;
    color: $text;
    padding: 0 1;
}

/* Row 2: Three panels side by side — one neutral border everywhere,
   the accent color is reserved for live state, not panel identity. */
#progress_panel,
#tool_execution_panel,
#ai_panel {
    border: solid $border;
    background: $bg-panel;
    padding: 1;
    overflow-y: auto;
}

/* Row 3: Findings spans full width */
#finding_panel {
    column-span: 3;
    border: solid $border;
    background: $bg-panel;
    padding: 1;
    overflow-y: auto;
}

/* ── Panel titles ── */
.panel-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    content-align: center middle;
    width: 100%;
    height: 1;
}

/* ── Module items ── */
.module-pending  { color: $text-dim; height: 1; }
.module-running  { color: $accent;   height: 1; text-style: bold; }
.module-complete { color: $text;     height: 1; }
.module-failed   { color: $crit;     height: 1; text-style: bold; }

.module-count {
    color: $text-dim;
    text-style: italic;
    height: 1;
    margin-top: 1;
}

ProgressBar {
    margin-top: 1;
}

ProgressBar > .bar--bar {
    color: $accent-dim;
}

ProgressBar > .bar--complete {
    color: $accent;
}

ProgressBar > .bar--indeterminate {
    color: $accent-dim;
}

PercentageStatus {
    color: $text-dim;
}

/* ── Finding cards — accent bar on the left, not a full colored box ── */
.finding-item {
    padding: 0 1;
    border-left: heavy $border;
    background: $bg-elevated;
    margin-bottom: 1;
    height: auto;
}

.finding-critical { border-left: heavy $crit; }
.finding-high     { border-left: heavy $high; }
.finding-medium   { border-left: heavy $med; }
.finding-low      { border-left: heavy $low; }
.finding-info     { border-left: heavy $info; }

#finding_counter {
    color: $text-dim;
    height: 1;
    margin-bottom: 1;
}

/* ── AI panel ── */
.ai-counter {
    color: $text-dim;
    text-style: italic;
    height: 1;
    margin-bottom: 1;
}

.ai-note {
    color: $text-faint;
    height: auto;
    padding: 0 1;
}

#ai_entries Collapsible {
    border: solid $border;
    background: $bg-elevated;
    margin: 0 0 1 0;
}

#ai_entries Collapsible > .collapsible--title {
    color: $accent;
    text-style: bold;
}

#ai_entries Static {
    height: auto;
    color: $text;
}

/* ── Tool execution log ── */
Collapsible {
    border: solid $border;
    background: $bg-elevated;
    margin: 1 0;
}

Collapsible > .collapsible--title {
    color: $text;
    text-style: bold;
}

RichLog {
    background: $bg;
    color: $text-dim;
    padding: 1;
    height: 100%;
}

/* ── Target setup ── */
TargetSetupScreen {
    background: $bg;
    align: center top;
}

.banner {
    color: $accent;
    text-style: bold;
    content-align: center middle;
    width: 100%;
    height: auto;
}

.subtitle {
    color: $text-dim;
    content-align: center middle;
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

.section-label {
    color: $text-dim;
    text-style: bold;
    margin-top: 1;
}

.input-group {
    padding: 1 2;
}

.profile-buttons {
    padding: 1 2;
    align: center middle;
}

.module-group {
    padding: 1 2;
}

#module_grid {
    layout: grid;
    grid-size: 3;
    grid-gutter: 0 1;
    grid-rows: auto;
    height: auto;
    margin-top: 1;
}

.module-checkbox {
    height: auto;
    width: auto;
}

/* API key status row — fixed height + vertical-centered so the two labels
   sit on the same line regardless of any margin the shared .section-label
   class would otherwise apply (that margin is what pushed them apart). */
.status-group {
    padding: 1 2;
    height: 3;
    align: left middle;
}

.status-label {
    color: $text-dim;
    text-style: bold;
    width: auto;
    margin-right: 1;
}

.status-success {
    color: $ok;
    text-style: bold;
}

.status-fail {
    color: $crit;
    text-style: bold;
}

Input {
    background: $bg-elevated;
    border: solid $border;
    color: $text;
}

Input:focus {
    border: solid $accent;
}

Checkbox {
    background: transparent;
    color: $text;
}

Button {
    background: $bg-elevated;
    color: $text;
    border: solid $border;
    text-style: none;
}

Button:hover {
    border: solid $accent;
    color: $accent;
}

Button.-success {
    background: $accent-dim;
    color: $text;
    border: solid $accent;
    text-style: bold;
}

Button.-success:hover {
    background: $accent;
    color: $bg;
}

Button.-primary {
    background: $accent-dim;
    color: $text;
    border: solid $accent;
    text-style: bold;
}

/* ── Report viewer ── */
Markdown {
    background: $bg;
    color: $text;
    padding: 1 2;
}
